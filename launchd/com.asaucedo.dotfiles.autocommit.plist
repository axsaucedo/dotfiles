<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asaucedo.dotfiles.autocommit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/asaucedo/Programming/dotfiles/bin/autocommit.sh</string>
    </array>

    <!-- Watch home/ ONLY. Watching the repo root would let the commit's own
         writes to .git retrigger the job, producing an infinite commit loop. -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/asaucedo/Programming/dotfiles/home</string>
    </array>

    <!-- Do not fire more than once a minute regardless of edit volume. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/asaucedo/Programming/dotfiles/tmp/autocommit.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/asaucedo/Programming/dotfiles/tmp/autocommit.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
