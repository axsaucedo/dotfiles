# Never track — secrets and machine-local config.
# This repo is public: anything matched here must stay in $HOME only.
.all_secret_keys
.zshrc.zalando
.zshrc.local
.zllm-completion.zsh
*.local
*.bak.*

# Scratch / working files
tmp/

# OS / editor noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*.swp
*.swo
*~
Thumbs.db

# Python
__pycache__/
*.py[cod]

# Vim runtime state — rewritten constantly; symlinking these would make the
# auto-commit watch fire on every vim session.
home/.vim/.netrwhist
home/.vim/spell/*.spl
